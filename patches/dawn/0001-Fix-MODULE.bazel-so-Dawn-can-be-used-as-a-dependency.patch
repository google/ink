From 8d26d895eddeb667243fd13d9f18b0393c68fd15 Mon Sep 17 00:00:00 2001
From: Samuel Freilich <sfreilich@google.com>
Date: Wed, 5 Aug 2026 12:14:40 -0400
Subject: [PATCH] Fix MODULE.bazel so Dawn can be used as a dependency

---
 MODULE.bazel | 46 ++++++++++++++++++----------------------------
 1 file changed, 18 insertions(+), 28 deletions(-)

diff --git a/MODULE.bazel b/MODULE.bazel
index 3552d03a2a..572ec1d46f 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -8,37 +8,27 @@ bazel_dep(name = "rules_cc", version = "0.2.18")
 bazel_dep(name = "rules_go", version = "0.59.0")
 bazel_dep(name = "rules_python", version = "1.5.1")
 bazel_dep(name = "platforms", version = "0.0.10")
-
-bazel_dep(name = "abseil-cpp", repo_name = "abseil_cpp")
-local_path_override(
-    module_name = "abseil-cpp",
-    path = "third_party/abseil-cpp",
+bazel_dep(name = "abseil-cpp", repo_name = "abseil_cpp", version="20260526.0")
+bazel_dep(
+    name = "google_benchmark",
+    repo_name = "benchmark",
+    version = "1.8.5",
+    dev_dependency = True,
 )
-
-bazel_dep(name = "google_benchmark", repo_name = "benchmark")
-local_path_override(
-    module_name = "google_benchmark",
-    path = "third_party/google_benchmark/src",
+bazel_dep(
+    name = "googletest",
+    repo_name = "gtest",
+    version = "1.17.0.bcr.2",
+    dev_dependency = True,
 )
-
-bazel_dep(name = "googletest", repo_name = "gtest")
-local_path_override(
-    module_name = "googletest",
-    path = "third_party/googletest",
+bazel_dep(
+    name = "spirv_headers",
+    version = "1.4.341.0",
 )
-
-bazel_dep(name = "spirv_headers")
-local_path_override(
-    module_name = "spirv_headers",
-    path = "third_party/spirv-headers/src",
+bazel_dep(
+    name = "spirv_tools",
+    version = "2026.1",
 )
-
-spirv_tools_repo = use_extension("//:third_party/spirv-tools/spirv_tools_repo.bzl", "spirv_tools_repo")
-use_repo(spirv_tools_repo, "spirv_tools")
-
 bazel_dep(name = "rules_proto", version = "6.0.2")
 bazel_dep(name = "protobuf", version = "33.0", repo_name = "com_google_protobuf")
-local_path_override(
-    module_name = "protobuf",
-    path = "third_party/protobuf",
-)
+
