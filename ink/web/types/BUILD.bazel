load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//javascript/typescript:build_defs.bzl", "ts_library")
load("//testing/karma/builddefs:karma_web_test_suite.bzl", "karma_web_test_suite")  # buildifier: disable=deprecated-function

package(
    default_applicable_licenses = ["//ink:license"],
    default_visibility = ["//ink:__subpackages__"],
)

cc_library(
    name = "duration_embind",
    srcs = ["duration_embind.cc"],
    tags = [
        "manual",
        "nobuilder",
        "notap",
    ],
    deps = [
        "//ink/types:duration",
        "//third_party/emscripten:embind",
    ],
    alwayslink = True,
)

cc_library(
    name = "physical_distance_embind",
    srcs = ["physical_distance_embind.cc"],
    tags = [
        "manual",
        "nobuilder",
        "notap",
    ],
    deps = [
        "//ink/types:physical_distance",
        "//third_party/emscripten:embind",
    ],
    alwayslink = True,
)

ts_library(
    name = "duration_test_lib",
    testonly = True,
    srcs = ["duration_test.ts"],
    deps = [
        "//ink/web:ink_wasm_loader",
        "//third_party/javascript/typings/jasmine",
    ],
)

karma_web_test_suite(
    name = "duration_test",
    browsers = ["//testing/web/browsers:chrome-linux"],
    configs = ["//ink/web:chrome_enable_unsafe_webgpu"],
    data = ["//ink/web:ink_wasm"],
    karma_plugins = ["//testing/web/build_defs/js_test/karma_plugins/localhost"],
    deps = [":duration_test_lib"],
)

ts_library(
    name = "physical_distance_test_lib",
    testonly = True,
    srcs = ["physical_distance_test.ts"],
    deps = [
        "//ink/web:ink_wasm_loader",
        "//third_party/javascript/typings/jasmine",
    ],
)

karma_web_test_suite(
    name = "physical_distance_test",
    browsers = ["//testing/web/browsers:chrome-linux"],
    configs = ["//ink/web:chrome_enable_unsafe_webgpu"],
    data = ["//ink/web:ink_wasm"],
    karma_plugins = ["//testing/web/build_defs/js_test/karma_plugins/localhost"],
    deps = [":physical_distance_test_lib"],
)
