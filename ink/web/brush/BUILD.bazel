load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//javascript/typescript:build_defs.bzl", "ts_library")
load("//testing/karma/builddefs:karma_web_test_suite.bzl", "karma_web_test_suite")  # buildifier: disable=deprecated-function

package(
    default_applicable_licenses = ["//ink:license"],
    default_visibility = ["//ink:__subpackages__"],
)

cc_library(
    name = "brush_paint_embind",
    srcs = ["brush_paint_embind.cc"],
    tags = [
        "manual",
        "nobuilder",
        "notap",
    ],
    deps = [
        "//ink/brush:brush_paint",
        "//ink/geometry:angle",
        "//ink/geometry:vec",
        "//third_party/emscripten:embind",
    ],
    alwayslink = True,
)

cc_library(
    name = "brush_coat_embind",
    srcs = ["brush_coat_embind.cc"],
    tags = [
        "manual",
        "nobuilder",
        "notap",
    ],
    deps = [
        "//ink/brush:brush_coat",
        "//ink/brush:brush_paint",
        "//ink/brush:brush_tip",
        "//third_party/emscripten:embind",
    ],
    alwayslink = True,
)

cc_library(
    name = "brush_family_embind",
    srcs = ["brush_family_embind.cc"],
    tags = [
        "manual",
        "nobuilder",
        "notap",
