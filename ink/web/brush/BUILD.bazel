    deps = [
        "//ink/brush:brush_coat",
        "//ink/brush:brush_family",
        "//third_party/emscripten:embind",
        "@abseil-cpp//absl/log:absl_check",
        "@abseil-cpp//absl/types:span",
    ],
    alwayslink = True,
)

