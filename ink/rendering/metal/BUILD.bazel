load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_apple//apple:resources.bzl", "apple_metal_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "objc_library")

package(
    default_visibility = ["//ink:__subpackages__"],
)

selects.config_setting_group(
    name = "ink_metal_platforms",
    match_any = [
        "@platforms//os:macos",
        "@platforms//os:ios",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cinterop_headers",
    srcs = glob(["*_native.h"]),
)

cc_library(
    name = "cinterop",
    target_compatible_with = [":ink_metal_platforms"],
    deps = [
        ":metal_renderer_native",
    ],
)

apple_metal_library(
    name = "INKMetalShaders",
    srcs = [
        "//ink/rendering/webgpu:StrokeShader_fragment.metal",
        "//ink/rendering/webgpu:StrokeShader_vertex.metal",
    ],
    target_compatible_with = [":ink_metal_platforms"],
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "input_to_bytes",
    srcs = ["input_to_bytes.cc"],
)

genrule(
    name = "ink_metal_shaders_bytes",
    srcs = [":INKMetalShaders"],
    outs = ["ink_metal_shaders.bytes"],
    cmd = "$(location :input_to_bytes) < $(SRCS) > $@",
    target_compatible_with = [":ink_metal_platforms"],
    tools = [":input_to_bytes"],
)

cc_library(
    name = "ink_metal_shaders_embedded",
    hdrs = ["ink_metal_shaders_embedded.h"],
    target_compatible_with = [":ink_metal_platforms"],
    textual_hdrs = [":ink_metal_shaders.bytes"],
)

objc_library(
    name = "texture_bitmap_store",
    hdrs = ["INKTextureBitmapStore.h"],
    module_name = "INKTextureBitmapStore",
    sdk_frameworks = [
        "CoreGraphics",
        "Foundation",
    ],
    target_compatible_with = [":ink_metal_platforms"],
    visibility = ["//visibility:public"],
)

objc_library(
    name = "metal_renderer_objc_helper",
    srcs = ["metal_renderer_objc_helper.mm"],
    hdrs = ["metal_renderer_objc_helper.h"],
    sdk_frameworks = [
        "CoreFoundation",
        "Foundation",
        "Metal",
        "MetalKit",
    ],
    target_compatible_with = [":ink_metal_platforms"],
    visibility = ["//visibility:private"],
    deps = [
        ":ink_metal_shaders_embedded",
        ":texture_bitmap_store",
        "//ink/brush:brush_paint",
        "//ink/geometry:mesh",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

cc_library(
    name = "metal_renderer",
    srcs = ["metal_renderer.cc"],
    hdrs = ["metal_renderer.h"],
    target_compatible_with = [":ink_metal_platforms"],
    deps = [
        ":metal_renderer_objc_helper",
        "//ink/brush",
        "//ink/brush:brush_coat",
        "//ink/brush:brush_family",
        "//ink/brush:brush_paint",
        "//ink/brush:color_function",
        "//ink/brush:stock_brushes",
        "//ink/color",
        "//ink/color:color_space",
        "//ink/geometry:mesh",
        "//ink/geometry:mesh_format",
        "//ink/geometry:mutable_mesh",
        "//ink/geometry:partitioned_mesh",
        "//ink/geometry:point",
        "//ink/rendering/common:stroke_attribute_helpers",
        "//ink/strokes:in_progress_stroke",
        "//ink/strokes:stroke",
        "//ink/strokes/input:stroke_input",
        "//ink/strokes/input:stroke_input_batch",
        "//ink/strokes/internal:stroke_vertex",
        "//ink/types:duration",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/log:absl_check",
        "@abseil-cpp//absl/log:absl_log",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_macros",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_library(
    name = "metal_renderer_native",
    srcs = ["metal_renderer_native.cc"],
    hdrs = ["metal_renderer_native.h"],
    target_compatible_with = [":ink_metal_platforms"],
    deps = [
        ":metal_renderer",
        "//ink/strokes:in_progress_stroke",
        "//ink/strokes:stroke",
        "//ink/strokes/internal/jni:in_progress_stroke_native_helper",
        "//ink/strokes/internal/jni:stroke_native_helper",
        "@abseil-cpp//absl/status:statusor",
    ],
)
