load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(":webgpu_shader.bzl", "generate_shader")

package(
    default_visibility = ["//ink:__subpackages__"],
)

generate_shader(
    name = "stroke_shader_metal_vertex",
    out = "StrokeShader_vertex.metal",
    entry_point = "vertexMain",
    format = "msl",
    wgsl = "StrokeShader.wgsl",
)

generate_shader(
    name = "stroke_shader_metal_fragment",
    out = "StrokeShader_fragment.metal",
    entry_point = "fragmentMain",
    format = "msl",
    wgsl = "StrokeShader.wgsl",
)

genrule(
    name = "stroke_shader_wgsl_string",
    srcs = ["StrokeShader.wgsl"],
    outs = ["StrokeShader.wgsl.string"],
    cmd = """echo 'R"wgsl(' > $@ && cat $(SRCS) >> $@ && echo ')wgsl"' >> $@""",
)

cc_library(
    name = "embedded_shaders",
    hdrs = ["embedded_shaders.h"],
    textual_hdrs = [":stroke_shader_wgsl_string"],
)

cc_library(
    name = "webgpu_renderer",
    srcs = ["webgpu_renderer.cc"],
    hdrs = ["webgpu_renderer.h"],
    deps = [
        ":embedded_shaders",
        "//ink/brush",
        "//ink/brush:brush_coat",
        "//ink/brush:brush_paint",
        "//ink/brush:color_function",
        "//ink/color",
        "//ink/geometry:affine_transform",
        "//ink/geometry:mesh",
        "//ink/geometry:mesh_format",
        "//ink/geometry:mesh_packing_types",
        "//ink/geometry:mutable_mesh",
        "//ink/geometry:partitioned_mesh",
        "//ink/geometry:point",
        "//ink/rendering/common:stroke_attribute_helpers",
        "//ink/strokes:in_progress_stroke",
        "//ink/strokes:stroke",
        "//ink/strokes/input:stroke_input_batch",
        "//ink/strokes/internal:stroke_vertex",
        "//third_party/dawn:webgpu_headers",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/log:absl_log",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
    ] + select({
        "//tools/cc_target_os:emscripten": [
            "//third_party/emdawnwebgpu:webgpu",
        ],
        "//conditions:default": [],
    }),
)

build_test(
    name = "generate_shaders_build_test",
    targets = [
        ":embedded_shaders",
        ":stroke_shader_metal_fragment",
        ":stroke_shader_metal_vertex",
    ],
)
