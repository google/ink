load("@emsdk//bazel/emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load(":ink_combine_headers.bzl", "ink_combine_headers")

package(
    default_visibility = ["//ink:__subpackages__"],
)

cc_binary(
    name = "ink_kmp_wasm_bin",
    linkopts = [
        "-lembind",
        "-sMODULARIZE=1",
        "-sEXPORT_NAME=createInkKmpModule",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sSINGLE_FILE=1",
        "-sWASM_ASYNC_COMPILATION=0",
    ],
    tags = [
        "manual",
        "notap",
        "requires_wasm_config",
    ],
    deps = [
        "//ink/geometry/internal/jni:embind",
    ],
)

wasm_cc_binary(
    name = "ink_kmp_wasm",
    cc_target = ":ink_kmp_wasm_bin",
    tags = ["no-lexan"],
)

cc_static_library(
    name = "ink",
    deps = [
        "//ink/brush/internal/jni:cinterop",
        "//ink/geometry/internal/jni:cinterop",
        "//ink/jni/internal:cinterop",
        "//ink/rendering/metal:cinterop",
        "//ink/storage/internal/jni:cinterop",
        "//ink/strokes/internal/jni:cinterop",
    ],
)

ink_combine_headers(
    name = "combined_headers",
    srcs = [
        "//ink/brush/internal/jni:cinterop_headers",
        "//ink/geometry/internal/jni:cinterop_headers",
        "//ink/jni/internal:cinterop_headers",
        "//ink/rendering/metal:cinterop_headers",
        "//ink/storage/internal/jni:cinterop_headers",
        "//ink/strokes/internal/jni:cinterop_headers",
    ],
    out = "ink_cinterop.h",
)
